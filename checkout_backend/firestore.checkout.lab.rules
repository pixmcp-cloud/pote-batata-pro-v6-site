rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function googleVerified() {
   return request.auth != null && request.auth.token.email_verified == true
    && request.auth.token.firebase.sign_in_provider == 'google.com';
  }
  function owner(storeId) {
   let store = get(/databases/$(database)/documents/checkoutLabStores/$(storeId));
   return googleVerified() && store.data.lab == true && store.data.ownerUid == request.auth.uid;
  }
  match /checkoutLabStores/{storeId}/orders/{orderId} {
   allow get, list: if owner(storeId);
   allow write: if false;
  }
  match /checkoutLabStores/{storeId}/customerViews/{orderId} {
   allow get: if googleVerified() && resource.data.customerUid == request.auth.uid
    && resource.data.storeId == storeId;
   allow list, write: if false;
  }
  match /{document=**} { allow read, write: if false; }
 }
}
