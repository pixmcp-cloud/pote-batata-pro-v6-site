rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Firebase verifies Google identity and email; browser UI cannot grant roles.
    function googleVerified() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function isAdmin() {
      return googleVerified() && request.auth.token.email == 'pixmcp@gmail.com';
    }
    function isOwner(userId) {
      return googleVerified() && request.auth.uid == userId;
    }
    function canAccess(userId) {
      return isOwner(userId) || isAdmin();
    }

    match /users/{userId} {
      allow get: if canAccess(userId);
      allow list: if isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.email == request.auth.token.email;
      allow update: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'photoURL', 'updatedAt'])
      );
      allow delete: if isAdmin();

      match /recipes/{id} {
        allow read, write: if canAccess(userId);
      }
      match /ingredients/{id} {
        allow read, write: if canAccess(userId);
      }
      match /suppliers/{id} {
        allow read, write: if canAccess(userId);
      }
      match /products/{id} {
        allow read, write: if canAccess(userId);
      }
      match /clients/{id} {
        allow read, write: if canAccess(userId);
      }
      match /orders/{id} {
        allow read, write: if canAccess(userId);
      }
      match /inventory/{id} {
        allow read, write: if canAccess(userId);
      }
      match /expenses/{id} {
        allow read, write: if canAccess(userId);
      }
      match /appState/{id} {
        allow read, write: if canAccess(userId);
      }
    }

    // Deny everything not explicitly listed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
